# Public origin of this deployment, used for canonical URLs, Open Graph images
# and the sitemap. Optional on Vercel (the project domain is used by default).
NEXT_PUBLIC_SITE_URL=https://review.example.com

# Set to "true" only for the public launch. Any other value keeps the whole
# deployment out of search engines (noindex + disallow-all robots.txt).
SITE_INDEXABLE=false
